# Copy to .env and fill in. .env is git-ignored. Do not put your password here;
# type it at the prompt or use: read -s TALKBANK_PASSWORD; export TALKBANK_PASSWORD
TALKBANK_EMAIL=you@university.edu
CHILD_ASR_RAW=/path/to/data/child_asr/raw
# Optional overrides (defaults are the Quest paths in scripts/build_manifest.py)
# CHILD_MANIFESTS=/path/to/data/child_asr/manifests
# CHAT_EXTRACTED=/path/to/extracted/chat/transcripts
# SIP_SEALED_IDS=/path/to/sealed/test_ids.txt
